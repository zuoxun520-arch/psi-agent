# =============================================================================
# E2E Workspace — MCP Server Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# All MCP_{PREFIX}_* vars configure _mcp_runtime.py's call_mcp() / list_mcp_tools().

# ── AI Backend (psi-agent ai) ─────────────────────────────────────────────────
# PSI_AI_PROVIDER=openai
# PSI_AI_MODEL=deepseek-v4-flash
# PSI_AI_API_KEY=sk-xxxxx
# PSI_AI_BASE_URL=https://api.deepseek.com

# ── VISION: Free Image Understanding (highest priority) ────────────────────────
# Requires: Node.js with npx. Completely free, no API key.
MCP_VISION_COMMAND=npx
MCP_VISION_ARGS=["-y", "@three-ws/vision-mcp"]

# ── PW: Playwright Browser Automation ──────────────────────────────────────────
# Requires: Node.js with npx
MCP_PW_COMMAND=npx
MCP_PW_ARGS=["-y", "@playwright/mcp@latest"]
# MCP_PW_TRANSPORT=stdio

# ── FS: Filesystem (read/write/edit/search) ───────────────────────────────────
# Requires: Node.js with npx
# WARNING: The directory path in ARGS is the root FS can access. Change as needed.
MCP_FS_COMMAND=npx
MCP_FS_ARGS=["-y", "@modelcontextprotocol/server-filesystem", "E:/"]
# For Linux/Mac: MCP_FS_ARGS=["-y", "@anthropic/mcp-server-filesystem", "/home/user"]

# ── FEISHU: Feishu/Lark Messaging ──────────────────────────────────────────────
# Option A: Webhook mode (simplest — text + cards only)
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxxxx

# Option B: API mode (full — image/file upload)
# FEISHU_APP_ID=cli_xxxxxxxxxx
# FEISHU_APP_SECRET=xxxxxxxxxx

MCP_FEISHU_COMMAND=uv
MCP_FEISHU_ARGS=["run", "python", "e2e-workspace/mcp_servers/feishu_server.py"]

# ── MEDIA: Image Generation / Vision / TTS / STT ──────────────────────────────
# Required for all MEDIA tools
OPENAI_API_KEY=sk-xxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1   # default

# Optional model overrides
# MEDIA_IMAGE_MODEL=dall-e-3
# MEDIA_VISION_MODEL=gpt-4o
# MEDIA_TTS_MODEL=tts-1-hd
# MEDIA_STT_MODEL=whisper-1

MCP_MEDIA_COMMAND=uv
MCP_MEDIA_ARGS=["run", "python", "e2e-workspace/mcp_servers/media_server.py"]

# ── SEARCH: Optional standalone ripgrep (if FS search is not enough) ──────────
# MCP_SEARCH_COMMAND=npx
# MCP_SEARCH_ARGS=["-y", "@anthropic/mcp-server-ripgrep"]
# MCP_SEARCH_TRANSPORT=stdio

# =============================================================================
# Usage:
#   source .env
#   uv run psi-agent ai --session-socket http://127.0.0.1:8765 --provider openai ...
#   uv run psi-agent session --workspace ./e2e-workspace --channel-socket ... --ai-socket ...
#   uv run psi-agent channel repl --session-socket ...
# =============================================================================
